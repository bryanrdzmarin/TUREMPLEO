// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}



model Usuario {
  id        Int      @id @default(autoincrement())
  nombre    String
  email     String   @unique
  password  String
  rol       String   @default("admin")
  creadoEn  DateTime @default(now())
}

model Candidato {
  id               Int                @id @default(autoincrement())
  ci               String             @unique
  nombre           String
  telefono         String?
  email            String?
  creadoEn         DateTime           @default(now())

  fechaNacimiento    String?
  edad               Int?
  sexo               String?
  colorPiel          String?
  colorPelo          String?
  peso               Float?
  estatura           Float?
  estadoCivil        String?
  municipioNacimiento String?
  nombrePadre        String?
  nombreMadre        String?

  direccion          String?
  reparto            String?
  municipio          String?
  provincia          String?
  telefonoParticular String?
  telefonoLaboral    String?
  telefonoFamiliar   String?

  nivelEscolar       String?
  especialidad       String?

  profesiones        String?
  idiomas            String?
  cursos             String?
  licenciaConduccion String?

  haTrabajadoTurismo  Boolean?
  experienciaTurismo  String?

  fuenteProcedencia  String?
  otraFuente         String?

trayectoriaPolitica String?

  solicitudes      Solicitud[]
   
}



model Hotel {
  id        Int      @id @default(autoincrement())
  nombre    String
  direccion String?
  creadoEn  DateTime @default(now())
}

model Plaza {
  id          Int      @id @default(autoincrement())
  nombre      String
  requisitos  String
  funciones   String
  activo      Boolean  @default(true)

  solicitudes Solicitud[]
}

model Solicitud {
  id          Int        @id @default(autoincrement())
  candidatoId Int
  plazaId     Int
  plazaNombre String
  estado      String     @default("pendiente")
  creadoEn    DateTime   @default(now())

  candidato   Candidato  @relation(fields: [candidatoId], references: [id])
  plaza       Plaza      @relation(fields: [plazaId], references: [id])

  @@unique([candidatoId, plazaId])

  requisitosCumplidos String?
  motivoDenegacion    String?
  pin                 String?
  citado              Boolean  @default(false)
  entrevistaPasada    Boolean?
  fechaEvaluacion     DateTime?

  cita               Cita?
  informacionCan    InformacionCan?
}



model Cita {
  id              Int      @id @default(autoincrement())
  solicitudId     Int      @unique
  fechaCita       String
  requisitos      String
  direccion       String
  creadoEn        DateTime @default(now())

  solicitud       Solicitud @relation(fields: [solicitudId], references: [id])
}


model InformacionCan {
  id          Int       @id @default(autoincrement())
  solicitudId Int       @unique
  solicitud   Solicitud @relation(fields: [solicitudId], references: [id])
  
  titulacion  String?
  oficios     String?
  idiomas     String?
  nivel       String?
  lugar       String?
  cursos      String?
  faltantes   String?
  licencia    String?
  comunitaria String?
  intrabajo  String?
  resultado   String?
  desempeno   String?
  
  creadoEn       DateTime  @default(now())
  actualizadoEn DateTime  @updatedAt
}




